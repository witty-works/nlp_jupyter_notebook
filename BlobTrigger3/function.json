{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "inblob",
      "type": "blobTrigger",
      "direction": "in",
      "path": "output-witty-rules/{name}.csv",
      "connection": "AzureWebJobsStorage"
    },
    {
      "name": "outblob",
      "type": "blob",
      "direction": "out",
      "path": "output-witty-rules/ignore.txt",
      "connection": "AzureWebJobsStorage"
    }
  ]
}