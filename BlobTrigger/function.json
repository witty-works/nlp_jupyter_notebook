{
  "scriptFile": "Hypen_transform_English.py",
  "bindings": [
    {
      "name": "blobTriggerTest",
      "type": "blobTrigger",
      "direction": "in",
      "path": "input-witty-rules/{name}.csv",
      "connection": "AzureWebJobsStorage"
    },
    {
      "name": "inputBlob",
      "type": "blob",
      "direction": "in",
      "path": "input-witty-rules/{name}.csv",
      "connection": "AzureWebJobsStorage"
    },
    {
      "type": "blob",
      "name": "outputBlob",
      "path": "output-witty-rules/{name}_h.csv",
      "direction": "out",
      "connection": "AzureWebJobsStorage"
    }
  ]
}